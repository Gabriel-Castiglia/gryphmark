#!/bin/sh
# Vigía package: quits a running Vigía before it is replaced, and removes Gryphmark, the name of this app up to
# 2.2.1 (its settings and drafts come over when Vigía starts; see Sources/Migration.swift).
# Only the copies in /Applications are quit: the dedicated instances in ~/Applications run their own executable
# copy and are separate apps, which the package does not replace.
# Copyright (C) 2026 Gabriel Castiglia. Licensed under the GNU GPL, version 2 only.
# SPDX-License-Identifier: GPL-2.0-only
user=$(/usr/bin/stat -f %Su /dev/console)

quit() {   # $1: pattern of the executable, $2: bundle identifier
    if /usr/bin/pgrep -qf "$1" && [ -n "$user" ] && [ "$user" != root ]; then
        uid=$(/usr/bin/id -u "$user")
        /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/osascript \
            -e "tell application id \"$2\" to quit" >/dev/null 2>&1
        sleep 2
    fi
    /usr/bin/pkill -f "$1" 2>/dev/null
}

quit '^/Applications/Vigia\.app/Contents/MacOS/Vigia( |$)' io.github.gabriel-castiglia.vigia

old=/Applications/Gryphmark.app
if [ -d "$old" ] && [ "$(/usr/bin/defaults read "$old/Contents/Info" CFBundleIdentifier 2>/dev/null)" = io.github.gabriel-castiglia.gryphmark ]; then
    quit '^/Applications/Gryphmark\.app/Contents/MacOS/Gryphmark( |$)' io.github.gabriel-castiglia.gryphmark
    /bin/rm -rf "$old"
fi
exit 0
